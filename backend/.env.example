PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/kite-garden

# Goldsky hosted subgraph HTTP (GraphQL). Copy SUBGRAPH_GRAPHQL_ENDPOINT from onchain/.env here, or set either name:
#   GOLDSKY_ENDPOINT=…
#   SUBGRAPH_GRAPHQL_ENDPOINT=…
GOLDSKY_ENDPOINT=https://api.goldsky.com/api/public/PROJECT_ID/subgraphs/attractorguard-kite-ai-testnet/5.0.2/gn
# Optional API key. For `/api/public/...` URLs the backend does NOT send Bearer by default (can break queries).
# Set GOLDSKY_BEARER_WITH_PUBLIC=true if your Goldsky project requires auth on a public URL.
GOLDSKY_API_KEY=
GOLDSKY_BEARER_WITH_PUBLIC=false
GOLDSKY_HISTORY_LIMIT=500

# If true, gate JSON includes logDecisionError when the chain write fails
GATE_VERBOSE_RESPONSE=false

# Start the service first: from repo, run python-service/START.bat (or: cd python-service && .venv\Scripts\python app.py)
PYTHON_SERVICE_URL=http://127.0.0.1:5050

KITE_RPC_URL=https://rpc-testnet.gokite.ai/
KITE_EXPLORER_BASE=https://testnet.kitescan.ai

ATTRACTOR_GUARD_ADDRESS=0x
AGENT_PAYMENT_SIMULATOR_ADDRESS=0x

# Backend wallet — must be authorized on AttractorGuard (setBackendAuthorization)
BACKEND_PRIVATE_KEY=0x

# Agent owner wallet — must match register/revoke/reauthorize on-chain (msg.sender = agent owner)
AGENT_OWNER_PRIVATE_KEY=0x

# Optional: checksummed EOA address returned as sessionKey when ISSUED (no AA yet). Trimmed on load.
STUB_SESSION_KEY_ADDRESS=

# Demo attack injection (POST /api/demo/inject-attack)
DEMO_MODE=false

# Dev only: skip EIP-712 x402 checks
SKIP_X402_VALIDATION=false

# Optional: submit logDecision via gokite-aa-sdk (see onchain/AA_SDK_INTEGRATION_GUIDE.md).
# Authorize predictedAaBackendAddress from GET /health on AttractorGuard when using AA (not the bare backend EOA).
USE_AA_SDK_FOR_LOG_DECISION=false
KITE_AA_NETWORK=kite_testnet
KITE_AA_BUNDLER_URL=
# AA_OWNER_ADDRESS=
# AA_ACCOUNT_SALT=
# When true with USE_AA_SDK_FOR_LOG_DECISION: ISSUED sends one UserOp batch — addSessionKeyRule on AA + logDecision on AttractorGuard.
USE_AA_SESSION_KEY_RULE=false
# Optional: AA account that implements addSessionKeyRule (defaults to predicted AA address).
# KITE_AA_ACCOUNT_ADDRESS=
# bytes4 function selector for the session key rule (default = EIP-3009 transferWithAuthorization).
# SESSION_KEY_ALLOWED_SELECTOR=0x
# DEMO_MODE + true = gate response includes generated session key private key (unsafe).
EXPOSE_GENERATED_SESSION_KEY_PRIVATE_KEY=false
