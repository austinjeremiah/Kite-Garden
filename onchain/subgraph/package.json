{
  "name": "attractorguard-subgraph",
  "version": "1.0.0",
  "description": "Goldsky subgraph for AttractorGuard on Kite AI testnet",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "deploy": "goldsky subgraph deploy attractorguard-kite-ai-testnet/1.0.0",
