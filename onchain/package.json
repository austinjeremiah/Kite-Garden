{
  "name": "attractorguard-onchain",
  "version": "1.0.0",
  "description": "AttractorGuard smart contracts and Goldsky subgraph for Kite AI testnet",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "coverage": "npx hardhat coverage",
    "deploy": "npx hardhat run scripts/deploy.js --network kiteTestnet",
    "deploy:local": "npx hardhat run scripts/deploy.js --network hardhat",
    "seed": "npx hardhat run scripts/seed.js --network kiteTestnet",
    "seed:agent": "npx hardhat run scripts/seed-agent-by-label.js --network kiteTestnet",
    "authorize-backend": "npx hardhat run scripts/authorize-backend.js --network kiteTestnet",
    "setup:demo": "npx hardhat run scripts/setup-demo-agents.js --network kiteTestnet",
    "register-with-metadata": "npx hardhat run scripts/register-agent-with-metadata.js --network kiteTestnet",
    "issue-session-keys-aa": "npx hardhat run scripts/issue-session-keys-aa-sdk.js --network kiteTestnet",
    "faucet-setup": "npx hardhat run scripts/faucet-setup.js --network kiteTestnet",
    "verify": "npx hardhat verify --network kiteTestnet",
    "clean": "npx hardhat clean",
    "node": "npx hardhat node"
  },
  "keywords": [
    "kite-ai",
    "attractor-guard",
    "behavioral-monitoring",
    "session-keys",
    "smart-contracts"
  ],
  "author": "AttractorGuard Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@typechain/ethers-v6": "^0.4.3",
    "@typechain/hardhat": "^8.0.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "gokite-aa-sdk": "^1.0.0"
  }
