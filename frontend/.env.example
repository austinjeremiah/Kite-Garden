# ─── Required ─────────────────────────────────────────────────────────────────

# Web3Auth — get one at https://dashboard.web3auth.io
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# Backend (Express) public URL
# Local dev: http://localhost:4000
# Vercel deploy: your publicly deployed backend (Railway / Render / ngrok / etc)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

